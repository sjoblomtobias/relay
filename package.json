{
	"name": "@sjoblomtobias/relay",
	"version": "3.0.1",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"dev": "tsx --watch test/index.ts",
		"lint": "oxlint src",
		"format": "prettier --write src",
		"typecheck:test": "tsc -p tsconfig.test.json",
		"prepublishOnly": "npm run build && npm run lint && npm run typecheck:test"
	},
	"author": "Tobias Sjöblom",
	"license": "Pirate",
	"description": "A lightweight TypeScript framework for building structured Express applications with decorator-based routing.",
	"keywords": [
		"express",
		"typescript",
		"framework",
		"decorators",
		"routing",
		"rest",
		"api",
		"server"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sjoblomtobias/relay.git"
	},
	"homepage": "https://github.com/sjoblomtobias/relay#readme",
	"bugs": {
		"url": "https://github.com/sjoblomtobias/relay/issues"
	},
	"dependencies": {
		"express": "^5.3.0"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"oxlint": "^1.89.0",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
